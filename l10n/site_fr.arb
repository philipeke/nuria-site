  "newfeatures.sunnat_title": "Pratiques Sunnat",
  "newfeatures.tasbeeh_li1": "Retour haptique à chaque pression",
  "newfeatures.tasbeeh_li2": "Remise à zéro automatique à votre objectif (33, 99…) avec un signal discret",
